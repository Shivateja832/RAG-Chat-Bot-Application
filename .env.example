# Local Ollama endpoint and models
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=180
CONTEXT_MAX_CHARS=1600

# Pinecone vector database
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentic-ai-ebook-nomic
PINECONE_NAMESPACE=agentic-ai-ebook
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Retrieval and chunking
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
CHUNK_SIZE=900
CHUNK_OVERLAP=140
EBOOK_PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
EBOOK_PDF_PATH=data/Agentic-AI.pdf
